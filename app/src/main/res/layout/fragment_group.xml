<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <TextView
                android:text="Nhóm &amp; Nợ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Text.H2" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_plus"
                android:padding="10dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                app:tint="@color/text_primary"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:background="@drawable/bg_segment_container"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Nhóm"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_segment_selected"
                style="@style/Text.Body" />

            <TextView
                android:text="Nợ / Cho vay"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/Text.Body" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:text="Phòng trọ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title" />

                    <TextView
                        android:text="4 thành viên · chia đều"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Text.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="V"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:textColor="@color/primary_600"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        style="@style/Text.Caption" />

                    <TextView
                        android:text="H"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:textColor="@color/primary_600"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:layout_marginStart="-8dp"
                        style="@style/Text.Caption" />

                    <TextView
                        android:text="T"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:textColor="@color/primary_600"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:layout_marginStart="-8dp"
                        style="@style/Text.Caption" />

                    <TextView
                        android:text="M"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:textColor="@color/primary_600"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:layout_marginStart="-8dp"
                        style="@style/Text.Caption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:text="Tổng chi nhóm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />

                    <TextView
                        android:text="6.400.000đ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Text.H2" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:text="Bạn cần trả"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />

                    <TextView
                        android:text="170.000đ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/expense"
                        android:layout_marginTop="2dp"
                        style="@style/Text.H2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:text="Cân đối công nợ (ít lần chuyển tiền nhất)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Text.Label" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_40">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_swap"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="@color/primary_600" />
                </FrameLayout>

                <TextView
                    android:text="Hiếu trả Vinh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="170.000đ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_40">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_swap"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="@color/primary_600" />
                </FrameLayout>

                <TextView
                    android:text="Minh trả Thạnh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="150.000đ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:text="Chi phí gần đây"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Text.Label" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_44">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bolt"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="@color/primary_600" />
                </FrameLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:text="Tiền điện tháng 10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        style="@style/Text.Body" />

                    <TextView
                        android:text="Vinh trả · chia đều 4 người"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Text.Caption" />
                </LinearLayout>

                <TextView
                    android:text="-320.000đ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/expense"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_44">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_food"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="@color/primary_600" />
                </FrameLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:text="Đi ăn lẩu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        style="@style/Text.Body" />

                    <TextView
                        android:text="Hiếu trả · chia đều 4 người"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Text.Caption" />
                </LinearLayout>

                <TextView
                    android:text="-480.000đ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/expense"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_plus"
                android:contentDescription="@null"
                app:tint="@color/surface" />

            <TextView
                android:text="Thêm chi phí nhóm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/surface"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"
                style="@style/Text.Body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
