<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:padding="10dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                app:tint="@color/text_primary" />

            <TextView
                android:text="Lọc giao dịch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/Text.H2" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null"
                app:tint="@color/text_muted" />

            <TextView
                android:text="Tìm theo ghi chú"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:layout_marginStart="10dp"
                style="@style/Text.Body" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Loại"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Label" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Tất cả"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/surface"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip_selected"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Chi tiêu"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Thu nhập"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Thời gian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Label" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Hôm nay"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Tuần này"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Tháng này"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/surface"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip_selected"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Năm nay"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Tùy chọn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Ví"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Label" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Tất cả ví"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/surface"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip_selected"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Tiền mặt"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Ngân hàng"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="MoMo"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Danh mục"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Label" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Ăn uống"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/surface"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip_selected"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Di chuyển"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Mua sắm"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Hóa đơn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Giải trí"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:textColor="@color/primary_600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_tonal"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:text="Đặt lại"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_600"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_primary"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:text="Áp dụng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/surface"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
