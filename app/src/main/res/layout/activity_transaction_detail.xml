<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="10dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                app:tint="@color/text_primary" />

            <TextView
                android:text="Chi tiết giao dịch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/Text.H2" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_dots"
                android:padding="10dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                app:tint="@color/text_primary"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_56">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_food"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/primary_600" />
            </FrameLayout>

            <TextView
                android:text="Ăn trưa cơm tấm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Text.Title" />

            <TextView
                android:text="-45.000đ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/expense"
                android:layout_marginTop="4dp"
                style="@style/Text.Amount" />

            <TextView
                android:text="Ăn uống"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                style="@style/Text.Caption" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_wallet"
                    android:contentDescription="@null"
                    app:tint="@color/text_muted" />

                <TextView
                    android:text="Ví"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Tiền mặt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="@null"
                    app:tint="@color/text_muted" />

                <TextView
                    android:text="Ngày"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="04/11/2026 · 12:10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_note"
                    android:contentDescription="@null"
                    app:tint="@color/text_muted" />

                <TextView
                    android:text="Ghi chú"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Ăn trưa cơm tấm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:text="Ảnh hóa đơn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Text.Label" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="center"
            android:background="@drawable/bg_receipt"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_receipt"
                android:contentDescription="@null"
                app:tint="@color/primary_600" />

            <TextView
                android:text="Ảnh hóa đơn đính kèm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_600"
                android:layout_marginTop="8dp"
                style="@style/Text.Caption" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_tonal"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_note"
                    android:contentDescription="@null"
                    app:tint="@color/primary_600" />

                <TextView
                    android:text="Sửa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_600"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_tonal"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="@null"
                    app:tint="@color/primary_600" />

                <TextView
                    android:text="Xóa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_600"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp"
                    style="@style/Text.Body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
