<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/fragmentContainer" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_plus"
            android:padding="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@null"
            app:tint="@color/surface"
            android:id="@+id/fabAdd" />
    </FrameLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/navHome"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@null"
                app:tint="@color/nav_item_color"
                android:duplicateParentState="true" />

            <TextView
                android:text="Trang chủ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_item_color"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                style="@style/Text.Nav" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/navHistory"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@null"
                app:tint="@color/nav_item_color"
                android:duplicateParentState="true" />

            <TextView
                android:text="Lịch sử"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_item_color"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                style="@style/Text.Nav" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/navBudget"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_budget"
                android:contentDescription="@null"
                app:tint="@color/nav_item_color"
                android:duplicateParentState="true" />

            <TextView
                android:text="Ngân sách"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_item_color"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                style="@style/Text.Nav" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/navGroup"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_group"
                android:contentDescription="@null"
                app:tint="@color/nav_item_color"
                android:duplicateParentState="true" />

            <TextView
                android:text="Nhóm &amp; Nợ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_item_color"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                style="@style/Text.Nav" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/navReport"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_report"
                android:contentDescription="@null"
                app:tint="@color/nav_item_color"
                android:duplicateParentState="true" />

            <TextView
                android:text="Báo cáo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_item_color"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                style="@style/Text.Nav" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
