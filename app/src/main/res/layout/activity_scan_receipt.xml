<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/text_primary"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:padding="10dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="@null"
                app:tint="@color/text_primary" />

            <TextView
                android:text="Quét hóa đơn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/surface"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/Text.H2" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:gravity="center"
            android:background="@drawable/bg_viewfinder"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_receipt"
                android:contentDescription="@null"
                app:tint="@color/surface" />

            <TextView
                android:text="Đưa hóa đơn vào khung hình"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/surface"
                android:textSize="13sp"
                android:layout_marginTop="12dp"
                style="@style/Text.Body" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Đã nhận diện"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                style="@style/Text.Body" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:text="Cửa hàng"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    style="@style/Text.Body" />

                <TextView
                    android:text="Quán cơm tấm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:text="Tổng tiền"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    style="@style/Text.Body" />

                <TextView
                    android:text="45.000đ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:text="Ngày"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_weight="1"
                    style="@style/Text.Body" />

                <TextView
                    android:text="04/11/2026"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_tonal"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="@null"
                        app:tint="@color/primary_600" />

                    <TextView
                        android:text="Chụp lại"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_600"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="8dp"
                        style="@style/Text.Body" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:text="Dùng kết quả"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/surface"
                        android:fontFamily="sans-serif-medium"
                        style="@style/Text.Body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
